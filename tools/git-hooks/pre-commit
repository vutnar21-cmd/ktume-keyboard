#!/bin/sh
# Хук pre-commit стандарта project-workflow.
# Подключение (один раз в основной копии): git config core.hooksPath tools/git-hooks
#
# 1. Папки tasks/ и research/ находятся в .gitignore и ведутся только локально на диске (даже на
#    main/master нельзя случайно закоммитить их через git add -f; удаление D из индекса разрешено).
# 2. Файл AGENTS.md правится и коммитится только в основной копии на master/main.
#
# Разово обойти проверку (осознанно): git commit --no-verify

staged_local=$(git diff --cached --name-only --diff-filter=ACMR -- tasks/ research/)
if [ -n "$staged_local" ]; then
    echo "pre-commit: папки tasks/ и research/ ведутся только локально и не должны попадать в Git:" >&2
    echo "$staged_local" | sed 's/^/    /' >&2
    echo "" >&2
    echo "Уберите файлы из индекса (на диске они сохранятся):" >&2
    echo "    git rm -r --cached tasks/ research/" >&2
    exit 1
fi

branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)

# На основной ветке master или main — без остальных ограничений
if [ "$branch" = "master" ] || [ "$branch" = "main" ]; then
    exit 0
fi

blocked=$(git diff --cached --name-only --diff-filter=ACMRD -- AGENTS.md AGENT.md)
[ -z "$blocked" ] && exit 0

echo "pre-commit: в ветке '${branch:-detached HEAD}' нельзя коммитить:" >&2
echo "$blocked" | sed 's/^/    /' >&2
echo "" >&2
echo "AGENTS.md правится только на master/main в основной копии." >&2
echo "Уберите файл из индекса:" >&2
echo "    git restore --staged AGENTS.md AGENT.md" >&2
echo "Разово обойти проверку: git commit --no-verify" >&2
exit 1
